{
  "name": "open-imaging-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "validate": "bun scripts/validate.ts",
    "schema": "bun scripts/schema.ts",
    "new-dataset": "bun scripts/new-dataset.ts",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test": "vitest --run && playwright test",
    "lookup": "bun scripts/lookup.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.52.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.2.6",
    "@types/node": "^26.6.4",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "marked": "^18.1.0",
    "minisearch": "^7.2.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Open, community-built index of medical imaging datasets with cohort statistics and license breakdowns",
  "license": "MIT"
}
