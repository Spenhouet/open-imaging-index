                  "yes",
                  "no",
                  "conditional",
                  "unspecified"
                ]
              }
            },
            "required": [
              "code",
              "label",
              "when"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "group",
          "label",
          "question",
          "good"
        ],
        "additionalProperties": false
      }
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "duo": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    }
